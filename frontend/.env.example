# Base URL for every API call made through src/services/apiClient.js.
# Must match the backend's mounted API prefix — see backend/.env.example (PORT) + backend/src/route.js.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# VAPID PUBLIC key for browser push (§6.7). MUST match the VAPID_PUBLIC_KEY of
# the backend that will sign the pushes — a subscription is bound to the key it
# was created with, so a mismatch means every push is rejected by the push
# service and the user silently receives nothing.
#
# Production and local currently use DIFFERENT keypairs, which is deliberate:
# a local test push can never reach a real user's browser. Set each environment
# to its own backend's public key.
#
# The PRIVATE key never appears here and must never reach the browser.
# Absent => the Settings push toggle renders nothing at all, the same way the
# backend's cleanup endpoint returns 503 when its secret is unset rather than
# running open.
VITE_VAPID_PUBLIC_KEY=
