# Base URL for every API call made through src/services/apiClient.js.
# Must match the backend's mounted API prefix — see backend/.env.example (PORT) + backend/src/route.js.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Google Maps JS SDK key for the Location live-map view (frontend/src/modules/location/).
# Deliberately SEPARATE from the backend's GOOGLE_MAPS_API_KEY (backend/.env.example) even
# though both call Google Maps — this one is loaded into the browser and visible to anyone
# who opens devtools, so it must be restricted by HTTP referrer (your deployed domain(s) +
# localhost for dev) in the Google Cloud Console, never by server IP the way the backend's
# key is. Enable the "Maps JavaScript API" (not Distance Matrix — that's the backend key's
# API) for this key.
VITE_GOOGLE_MAPS_API_KEY=
