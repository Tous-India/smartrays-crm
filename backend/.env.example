# Copy this file to .env and .env.local, then fill in real values.
# Never commit .env or .env.local — see .gitignore.

# --- Server ---
NODE_ENV=development
PORT=5000

# --- Database ---
# Local development uses a LOCAL database. Outside NODE_ENV=production the server
# refuses to connect to anything that is not localhost (src/config/databaseGuard.js)
# unless ALLOW_REMOTE_DB=true is set on purpose. Production (Vercel) is not checked.
MONGODB_URI=mongodb://127.0.0.1:27017/smartrays_dev
# ALLOW_REMOTE_DB=true

# --- Auth (JWT cookie) ---
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_NAME=smartrays_token
# Mobile app sessions (mobile-backend-plan.md §1) — optional, defaults shown.
# The web session is unaffected; JWT_EXPIRES_IN still governs the cookie.
MOBILE_ACCESS_TOKEN_TTL=15m
MOBILE_REFRESH_TOKEN_TTL_DAYS=30

# --- Frontend origin (for CORS + cookie sameSite behavior) ---
# Comma-separated list accepted (2026-08-04) — list every port your local
# Vite dev server might land on (it falls back to 5174, 5175, etc. if 5173
# is already taken by another running instance) so CORS doesn't silently
# block login/API calls from whichever port it actually picked. Production
# should stay a single value (e.g. https://crm.smartrayssolutions.com) —
# this multi-origin support is specifically for absorbing local dev port
# drift, not production flexibility. See backend/README.md's CORS section.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# --- One-time admin bootstrap (used only by `npm run seed:admin`, see backend/README.md) ---
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- File storage (Cloudinary) — required as of Phase 3 (Attendance check-in/check-out photos) ---
# See .context/final-plan.md §3/§11.6/§7.4
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Credentials vault encryption (required — Phase 2 customer module) ---
# 32-byte key, base64-encoded, used for AES-256-GCM. See .context/final-plan.md §6.3/§11.8
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=

# --- Live Location Tracking (§7.4b) — optional, defaults to 2 if unset ---
# Minutes between location pings; the client reads this via GET /location/config
# so the ping cadence can change without a client redeploy.
LOCATION_PING_INTERVAL_MINUTES=2

# --- Attendance connectivity-gap detection (§6.5/§7.4) — optional, defaults to 10 if unset ---
# Minutes of silence between heartbeats (or the last heartbeat and checkout) before a
# connectivityGaps[] entry is recorded for that employee's shift.
ATTENDANCE_GAP_THRESHOLD_MINUTES=10

# --- Attendance/Location geofencing (§6.5/§7.4) — optional, defaults to 500 if unset ---
# Meters a location ping may drift from the shift's check-in point before it's recorded
# as a geofenceViolations[] entry on that employee's Attendance record.
GEOFENCE_RADIUS_METERS=500
# A location fix reported with an accuracy worse than this (metres) is not
# evaluated against the geofence (mobile-backend-plan.md §3.6). Only applies
# to pings that carry coords.accuracy — the mobile app; web pings have none.
GEOFENCE_MAX_ACCURACY_METERS=100

# How many days of Attendance history to keep before the retention job deletes
# the record AND its Cloudinary check-in/check-out photos (§6.5, 2026-08-05).
# Optional — defaults to 45 if unset. A record is never deleted until payroll
# has been generated for its month; see backend/README.md's Data retention
# section for the full ordering and safety guarantees.
ATTENDANCE_RETENTION_DAYS=45

# Shared secret for POST /attendance/cleanup, which Vercel Cron calls daily.
# Machine-only: the endpoint is NOT reachable through normal user auth. Same
# x-webhook-token pattern as WEBSITE_LEAD_INTAKE_TOKEN below. If unset, the
# endpoint refuses every request (503) rather than running unauthenticated.
ATTENDANCE_CLEANUP_TOKEN=

# --- Transport/Travel (§6.5/§7.6) — required ---
# Google Maps Distance Matrix API key, used to compute TravelLog.distanceKm both for
# auto-generated logs (from Attendance check-in/check-out coords) and manual entries
# that supply coords without an explicit distanceKm override.
GOOGLE_MAPS_API_KEY=

# --- Payroll mileage reimbursement (§6.5/§7.7) — optional, defaults to 10 if unset ---
# Currency units per km, applied to that employee's *approved* TravelLog distanceKm total
# for the month (payroll.service.js#runPayroll). PLACEHOLDER VALUE — this is a deliberately
# simple v1 (one single global rate, not per-role/per-project); the client must confirm the
# real rate before payroll is run for real.
MILEAGE_RATE_PER_KM=10

# --- Web Push / VAPID (§6.7/§7.11-Platform, Phase 9) — required ---
# Powers the Notification module's push delivery (lead assignment, ticket assignment,
# lead follow-up reminders). Generate a real keypair — there's no safe placeholder for a
# public-key-cryptography pair — with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# from backend/, then paste the printed publicKey/privateKey below.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional — a mailto:/https: contact URL, per the Web Push spec, so a push service
# operator has somewhere to reach the sender about abuse. Defaults to
# mailto:support@smartrayssolutions.com if unset.
VAPID_SUBJECT=

# --- Firebase Cloud Messaging for the Android app (mobile-backend-plan.md §2) — optional ---
# Off unless FCM_ENABLED=true; with it off the app's device registrations are
# stored but nothing is sent to them, and the backend boots exactly as before.
# With it on, the three values below are REQUIRED at boot. They come from a
# Firebase service-account key (Firebase console → Project settings → Service
# accounts → Generate new private key): copy project_id, client_email and
# private_key out of that JSON — the file itself is never committed and never
# placed on a server. The private key spans many lines; paste it as ONE line
# with literal 
 sequences (which is how Vercel's env editor stores it) —
# env.js unescapes them. Never log or echo these values.
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Forgotten check-out (§7.74) — optional ---
# A shift still open after SHIFT_REMINDER_AFTER_HOURS gets ONE push reminder
# ("still checked in?"); after TRACKING_STOP_AFTER_HOURS the APP stops
# location tracking for that shift and says so. Neither closes the shift or
# edits the attendance record — that stays with the employee or an admin.
# Both are read by the app from GET /location/config. Defaults 10 and 12.
SHIFT_REMINDER_AFTER_HOURS=10
TRACKING_STOP_AFTER_HOURS=12

# --- Customer complaints (2026-10-23) — optional, defaults shown ---
# Not assigned COMPLAINT_ASSIGN_REMINDER_HOURS after it arrived (or was sent back) →
# the assigners (admins + complaints.assign) are reminded. Visit date passed (plus
# COMPLAINT_VISIT_GRACE_HOURS) and not resolved → the technician and the assigners.
# Runs on activity plus a daily Vercel Cron backstop
# (/api/v1/tickets/escalations/run, same credential as the attendance cleanup).
COMPLAINT_ASSIGN_REMINDER_HOURS=4
COMPLAINT_VISIT_GRACE_HOURS=0
# --- Verified site visits (2026-10-22) — optional, default shown ---
# How close (metres) the phone must be to the site to tap Arrived / Done or add a site photo.
# The accuracy rule is the attendance one (GEOFENCE_MAX_ACCURACY_METERS).
VISIT_RADIUS_METERS=200

# Cloudinary folder root for uploads. Set e.g. smartrays-dev on a local machine so its
# test uploads stay apart from production's. Defaults to smartrays.
# CLOUDINARY_FOLDER_ROOT=smartrays-dev

# --- SMTP / password reset email (§7.13) — required ---
# Powers the self-service "forgot password" flow's reset email
# (src/services/email.service.js). Any standard SMTP provider works
# (Gmail app password, SendGrid, Mailgun, etc.).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Website lead-intake webhook (§7.25) — optional, unset disables the route ---
# Shared secret for POST /leads/website-intake, the public (unauthenticated) endpoint
# the WordPress/Forminator "Get a Quote" form's webhook add-on posts submissions to.
# Sent by the caller as an X-Webhook-Token header; if this is unset, that route
# refuses every request rather than accepting unauthenticated writes with no lock.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WEBSITE_LEAD_INTAKE_TOKEN=
