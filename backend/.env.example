# Copy this file to .env and .env.local, then fill in real values.
# Never commit .env or .env.local — see .gitignore.

# --- Server ---
NODE_ENV=development
PORT=5000

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/smartrays_dev

# --- Auth (JWT cookie) ---
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_NAME=smartrays_token

# --- Frontend origin (for CORS + cookie sameSite behavior) ---
CLIENT_ORIGIN=http://localhost:5173

# --- One-time admin bootstrap (used only by `npm run seed:admin`, see backend/README.md) ---
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- File storage (Cloudinary) — required as of Phase 3 (Attendance check-in/check-out photos) ---
# See .context/final-plan.md §3/§11.6/§7.4
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Credentials vault encryption (required — Phase 2 customer module) ---
# 32-byte key, base64-encoded, used for AES-256-GCM. See .context/final-plan.md §6.3/§11.8
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=

# --- Live Location Tracking (§7.4b) — optional, defaults to 2 if unset ---
# Minutes between location pings; the client reads this via GET /location/config
# so the ping cadence can change without a client redeploy.
LOCATION_PING_INTERVAL_MINUTES=2

# --- Attendance connectivity-gap detection (§6.5/§7.4) — optional, defaults to 10 if unset ---
# Minutes of silence between heartbeats (or the last heartbeat and checkout) before a
# connectivityGaps[] entry is recorded for that employee's shift.
ATTENDANCE_GAP_THRESHOLD_MINUTES=10

# --- Transport/Travel (§6.5/§7.6) — required ---
# Google Maps Distance Matrix API key, used to compute TravelLog.distanceKm both for
# auto-generated logs (from Attendance check-in/check-out coords) and manual entries
# that supply coords without an explicit distanceKm override.
GOOGLE_MAPS_API_KEY=

# --- Payroll mileage reimbursement (§6.5/§7.7) — optional, defaults to 10 if unset ---
# Currency units per km, applied to that employee's *approved* TravelLog distanceKm total
# for the month (payroll.service.js#runPayroll). PLACEHOLDER VALUE — this is a deliberately
# simple v1 (one single global rate, not per-role/per-project); the client must confirm the
# real rate before payroll is run for real.
MILEAGE_RATE_PER_KM=10
