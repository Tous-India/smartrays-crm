{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/attendance/cleanup",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/v1/attendance/open-shift-reminders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/v1/tickets/escalations/run",
      "schedule": "30 3 * * *"
    }
  ]
}
