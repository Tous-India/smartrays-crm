# Copied to app/.env on each machine (gitignored). Read at BUILD time by
# react-native-config — change it, rebuild the debug app.
#
# The Android emulator reaches the host machine at 10.0.2.2, not localhost.
# A physical phone on the same Wi-Fi uses the machine's LAN address instead.
# Debug builds may use http:// only for the host named in
# android/app/src/debug/res/xml/network_security_config.xml; release builds
# are HTTPS only.
API_BASE_URL=http://10.0.2.2:5050/api/v1
